Options -MultiViews
RewriteEngine On
RewriteBase /

# ── SEO: Canonical domain — 301 redirect non-www → www ──
RewriteCond %{HTTP_HOST} ^thebeanshub\.com [NC]
RewriteRule ^(.*)$ https://www.thebeanshub.com/$1 [R=301,L]

# ── SEO: 301 redirects for old WordPress URLs (9.2k 404s in GSC) ──
# Old bean pages lived under /product/, /coffee_bean/, /coffee-beans/.
# Match origin in the slug → closest /shop/ category page.
RewriteRule ^(?:product|coffee_bean|coffee-beans)/.*ethiopia /shop/ethiopia-coffee-beans [R=301,L,NC]
RewriteRule ^(?:product|coffee_bean|coffee-beans)/.*colombia /shop/colombia-coffee-beans [R=301,L,NC]
RewriteRule ^(?:product|coffee_bean|coffee-beans)/.*brazil /shop/brazil-coffee-beans [R=301,L,NC]
RewriteRule ^(?:product|coffee_bean|coffee-beans)/.*yunnan /shop/yunnan-coffee-beans [R=301,L,NC]
RewriteRule ^(?:product|coffee_bean|coffee-beans)/.*indonesia /shop/indonesia-coffee-beans [R=301,L,NC]
RewriteRule ^(?:product|coffee_bean|coffee-beans)/.*thailand /shop/thailand-coffee-beans [R=301,L,NC]
# No matching origin → match by processing method.
RewriteRule ^(?:product|coffee_bean|coffee-beans)/.*(anaerobic|carbonic|ferment) /shop/fermented-coffee-beans [R=301,L,NC]
RewriteRule ^(?:product|coffee_bean|coffee-beans)/.*washed /shop/washed-process-coffee-beans [R=301,L,NC]
RewriteRule ^(?:product|coffee_bean|coffee-beans)/.*natural /shop/natural-process-coffee-beans [R=301,L,NC]
RewriteRule ^(?:product|coffee_bean|coffee-beans)/.*blend /shop/arabica-blend-coffee-beans [R=301,L,NC]
# Old origin taxonomy pages.
RewriteRule ^origin_country/ethiopia /shop/ethiopia-coffee-beans [R=301,L,NC]
RewriteRule ^origin_country/colombia /shop/colombia-coffee-beans [R=301,L,NC]
RewriteRule ^origin_country/brazil /shop/brazil-coffee-beans [R=301,L,NC]
RewriteRule ^origin_country/yunnan /shop/yunnan-coffee-beans [R=301,L,NC]
RewriteRule ^origin_country/indonesia /shop/indonesia-coffee-beans [R=301,L,NC]
RewriteRule ^origin_country/thailand /shop/thailand-coffee-beans [R=301,L,NC]
# Everything else from the old WP structure → main shop page.
RewriteRule ^(?:product|coffee_bean|coffee-beans|origin_country|brand)(/.*)?$ /shop [R=301,L,NC]

# Remove .html extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# Redirect .html URLs to clean URLs
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1 [NC,R=301,L]

# Home
RewriteRule ^$ index.html [L]

# Clean URLs for posts subfolder
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^posts/([^\.]+)$ posts/$1.html [NC,L]

RewriteCond %{THE_REQUEST} /posts/([^.]+)\.html [NC]
RewriteRule ^ /posts/%1 [NC,R=301,L]

# ──────────────────────────────────────────────────

<IfModule mod_headers.c>
Header set Content-Security-Policy "script-src 'self' 'unsafe-inline' 'unsafe-eval' *thebeanshub.com"
</IfModule>

# BEGIN LSCACHE
## LITESPEED WP CACHE PLUGIN - Do not edit the contents of this block! ##
<IfModule LiteSpeed>
RewriteEngine on
CacheLookup on
RewriteRule .* - [E=Cache-Control:no-autoflush]
RewriteRule litespeed/debug/.*\.log$ - [F,L]
RewriteRule \.litespeed_conf\.dat - [F,L]

### marker ASYNC start ###
RewriteCond %{REQUEST_URI} /wp-admin/admin-ajax\.php
RewriteCond %{QUERY_STRING} action=async_litespeed
RewriteRule .* - [E=noabort:1]
### marker ASYNC end ###

### marker DROPQS start ###
CacheKeyModify -qs:fbclid
CacheKeyModify -qs:gclid
CacheKeyModify -qs:utm*
CacheKeyModify -qs:_ga
### marker DROPQS end ###

</IfModule>
## LITESPEED WP CACHE PLUGIN - Do not edit the contents of this block! ##
# END LSCACHE
# BEGIN NON_LSCACHE
## LITESPEED WP CACHE PLUGIN - Do not edit the contents of this block! ##
## LITESPEED WP CACHE PLUGIN - Do not edit the contents of this block! ##
# END NON_LSCACHE
# (Removed leftover WordPress block — this is a static site; it was
# rewriting all missing URLs to /index.php, which doesn't exist.)
